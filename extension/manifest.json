{
  "manifest_version": 3,
  "name": "LinkedIn Outreach AI",
  "version": "4.0.0",
  "description": "Writes LinkedIn notes and messages. Free Mode works on your device; AI Mode uses your own Anthropic API key.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LinkedIn Outreach AI"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["scraper.js", "content_script.js", "utils/writer.js", "inpage.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
